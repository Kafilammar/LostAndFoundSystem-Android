<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LostFoundApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lostandfoundsystem"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- شاشة البداية -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Lostandfoundsystem.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".UserTypeActivity" android:exported="false" />
        <activity android:name=".HomeActivity" android:exported="false" />
        <activity android:name=".SearchActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ItemDetailsActivity" android:exported="false" />
        <activity android:name=".ReportItemActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SubmissionSuccessActivity" android:exported="false" />
        <activity android:name=".MyReportsActivity" android:exported="false" />
        <activity android:name=".NotificationsActivity" android:exported="false" />
        <activity android:name=".ProfileActivity" android:exported="false" />
        <activity android:name=".EditProfileActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".HelpActivity" android:exported="false" />
        <activity android:name=".AdminDashboardActivity" android:exported="false" />
        <activity android:name=".AdminReportReviewActivity" android:exported="false" />
        <activity android:name=".MatchReviewActivity" android:exported="false" />
        <activity android:name=".CenterDashboardActivity" android:exported="false" />
        <activity android:name=".CenterReportsActivity" android:exported="false" />
        <activity android:name=".DeliveryConfirmationActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- حفظ لغة التطبيق (العربية) على الأجهزة الأقدم من Android 13 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
