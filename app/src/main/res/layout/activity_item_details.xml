<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <LinearLayout style="@style/LF.Toolbar">
        <ImageView
            android:id="@+id/btnBackDetails"
            style="@style/LF.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />
        <TextView
            android:id="@+id/tvDetailsTitle"
            style="@style/LF.Toolbar.Title"
            android:text="تفاصيل البلاغ" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/app_background">

        <ProgressBar
            android:id="@+id/detailsProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/ksu_blue" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/detailsContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivItemDetails"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:background="@color/white"
                    android:contentDescription="صورة الغرض"
                    android:scaleType="centerInside"
                    app:shapeAppearanceOverlay="@style/LF.Shape.Medium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetailsType"
                        style="@style/LF.Text.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        style="@style/LF.Text.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvItemName"
                    style="@style/LF.Text.H1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="22sp" />

                <LinearLayout
                    android:id="@+id/btnCopyCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ticket"
                        app:tint="@color/ksu_blue_light" />

                    <TextView
                        android:id="@+id/tvReportCode"
                        style="@style/LF.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/ksu_blue_light" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="نسخ"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/ksu_blue_light" />
                </LinearLayout>

                <!-- ملاحظة الحالة -->
                <LinearLayout
                    android:id="@+id/noticeBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_notice_blue"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/noticeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        app:tint="@color/ksu_blue" />

                    <TextView
                        android:id="@+id/tvNotice"
                        style="@style/LF.Text.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/ksu_blue" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/LF.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp">

                        <include android:id="@+id/rowCategory" layout="@layout/view_info_row" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                        <include android:id="@+id/rowLocation" layout="@layout/view_info_row" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                        <include android:id="@+id/rowDate" layout="@layout/view_info_row" />
                        <View android:id="@+id/rowDetailsDivider" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                        <include android:id="@+id/rowDetails" layout="@layout/view_info_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/LF.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/LF.Text.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="الوصف" />

                        <TextView
                            android:id="@+id/tvDescription"
                            style="@style/LF.Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- أغراض قد تكون لصاحب البلاغ المفقود -->
                <LinearLayout
                    android:id="@+id/candidatesSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/LF.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="أغراض قد تكون لك" />

                    <TextView
                        style="@style/LF.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="مرتبة حسب نسبة التطابق. إذا وجدت غرضك اضغط (هذا غرضي) ليصل طلبك للإدارة، ثم يتم التحقق في المركز." />

                    <ProgressBar
                        android:id="@+id/candidatesProgress"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/ksu_blue" />

                    <LinearLayout
                        android:id="@+id/candidatesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/candidatesEmpty"
                        style="@style/LF.Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_notice_blue"
                        android:padding="14dp"
                        android:text="لا توجد أغراض مطابقة حاليًا. سنُشعرك فور ظهور غرض يشبه بلاغك."
                        android:textColor="@color/ksu_blue"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotMine"
                    style="@style/LF.Button.Outlined.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="هذا ليس غرضي"
                    android:visibility="gone"
                    app:icon="@drawable/ic_close" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelivery"
                    style="@style/LF.Button.Green"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="تسليم الغرض إلى المركز"
                    android:visibility="gone"
                    app:icon="@drawable/ic_hand_heart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminReview"
                    style="@style/LF.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="مراجعة البلاغ (الإدارة)"
                    android:visibility="gone"
                    app:icon="@drawable/ic_dashboard" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteReport"
                    style="@style/LF.Button.Outlined.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="حذف البلاغ"
                    android:visibility="gone"
                    app:icon="@drawable/ic_delete" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
