<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <LinearLayout style="@style/LF.Toolbar">
        <ImageView
            android:id="@+id/btnBackAdminReview"
            style="@style/LF.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />
        <TextView
            style="@style/LF.Toolbar.Title"
            android:text="مراجعة البلاغ" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/app_background">

        <ProgressBar
            android:id="@+id/adminReviewProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/ksu_blue" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/adminReviewContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAdminReview"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:background="@color/white"
                    android:contentDescription="صورة الغرض"
                    android:scaleType="centerInside"
                    app:shapeAppearanceOverlay="@style/LF.Shape.Medium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAdminReviewType"
                        style="@style/LF.Text.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvAdminReviewStatus"
                        style="@style/LF.Text.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAdminReviewName"
                    style="@style/LF.Text.H1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvAdminReviewCode"
                    style="@style/LF.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ksu_blue_light" />

                <!-- سبب الرفض -->
                <LinearLayout
                    android:id="@+id/rejectNoticeBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_notice_red"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/danger_text" />

                    <TextView
                        android:id="@+id/tvRejectReason"
                        style="@style/LF.Text.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/danger_text" />
                </LinearLayout>

                <!-- المطابقة الحالية (للبلاغ المرتبط بمطابقة) -->
                <LinearLayout
                    android:id="@+id/matchInfoBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_notice_yellow"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvMatchInfo"
                        style="@style/LF.Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/warning_text" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenMatchedItem"
                            style="@style/LF.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="عرض الغرض المطابق" />

                        <Space android:layout_width="8dp" android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUnlinkMatch"
                            style="@style/LF.Button.Outlined.Danger"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="إلغاء المطابقة" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/LF.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp">

                        <include android:id="@+id/reviewRowCategory" layout="@layout/view_info_row" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                        <include android:id="@+id/reviewRowLocation" layout="@layout/view_info_row" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                        <include android:id="@+id/reviewRowDate" layout="@layout/view_info_row" />
                        <View android:id="@+id/reviewRowDetailsDivider" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                        <include android:id="@+id/reviewRowDetails" layout="@layout/view_info_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/LF.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/LF.Text.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="الوصف" />

                        <TextView
                            android:id="@+id/tvAdminReviewDescription"
                            style="@style/LF.Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- بيانات المُبلِّغ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/LF.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvReporterAvatar"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_circle_blue"
                            android:gravity="center"
                            android:text="م"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/LF.Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="المُبلِّغ" />

                            <TextView
                                android:id="@+id/tvReporterName"
                                style="@style/LF.Text.Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="—" />

                            <TextView
                                android:id="@+id/tvReporterId"
                                style="@style/LF.Text.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/btnCallReporter"
                            style="@style/LF.IconButton.Circle"
                            android:contentDescription="اتصال بالمبلغ"
                            android:padding="11dp"
                            android:src="@drawable/ic_phone"
                            android:visibility="gone"
                            app:tint="@color/found_green" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- الإجراءات -->
                <LinearLayout
                    android:id="@+id/adminReviewActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartReview"
                        style="@style/LF.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="بدء التدقيق"
                        app:icon="@drawable/ic_refresh" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnApproveReport"
                            style="@style/LF.Button.Green"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="اعتماد"
                            app:icon="@drawable/ic_check" />

                        <Space android:layout_width="10dp" android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRejectReport"
                            style="@style/LF.Button.Outlined.Danger"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="رفض"
                            app:icon="@drawable/ic_close" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminDelete"
                    style="@style/LF.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="حذف البلاغ نهائيًا"
                    android:textColor="@color/danger_text" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
