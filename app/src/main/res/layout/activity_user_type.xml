<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="شعار جامعة الملك سعود"
            android:src="@drawable/logo_ksu" />

        <TextView
            android:id="@+id/tvUserTypeGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="جامعة الملك سعود"
            android:textColor="@color/ksu_blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            style="@style/LF.Text.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="ما الذي تريد القيام به؟" />

        <TextView
            style="@style/LF.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="اختر الخيار المناسب لمساعدتنا في خدمتك بشكل أفضل." />

        <LinearLayout
            android:id="@+id/layoutLost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_option_lost_selected"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="96dp"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iconLost"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@null"
                android:padding="14dp"
                android:src="@drawable/ic_search"
                app:tint="@color/selection_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/LF.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="أبحث عن شيء مفقود"
                    android:textSize="16sp" />

                <TextView
                    style="@style/LF.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="أبلغ عن مفقوداتك وتابع حالتها" />
            </LinearLayout>

            <ImageView
                android:id="@+id/radioLost"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_option"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="96dp"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iconFound"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_green_soft"
                android:contentDescription="@null"
                android:padding="14dp"
                android:src="@drawable/ic_hand_heart"
                app:tint="@color/found_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/LF.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="وجدت شيئًا وأريد إعادته"
                    android:textSize="16sp" />

                <TextView
                    style="@style/LF.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="أبلغ عن شيء عثرت عليه" />
            </LinearLayout>

            <ImageView
                android:id="@+id/radioFound"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/LF.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="متابعة" />

        <TextView
            android:id="@+id/btnUserTypeLogout"
            style="@style/LF.Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="تسجيل الخروج"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
