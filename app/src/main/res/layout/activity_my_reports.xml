<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <LinearLayout style="@style/LF.Toolbar">
        <ImageView
            android:id="@+id/btnBackMyReports"
            style="@style/LF.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />
        <TextView
            android:id="@+id/tvMyReportsTitle"
            style="@style/LF.Toolbar.Title"
            android:text="تقاريري" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/myReportsChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            app:checkedChip="@+id/chipAll"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/chipAll" style="@style/LF.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الكل" />
            <com.google.android.material.chip.Chip android:id="@+id/chipReview" style="@style/LF.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="قيد المراجعة" />
            <com.google.android.material.chip.Chip android:id="@+id/chipMatched" style="@style/LF.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="معتمدة ومطابقة" />
            <com.google.android.material.chip.Chip android:id="@+id/chipDone" style="@style/LF.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مكتملة" />
            <com.google.android.material.chip.Chip android:id="@+id/chipRejected" style="@style/LF.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مرفوضة" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/app_background">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/myReportsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="96dp" />

        <ProgressBar
            android:id="@+id/myReportsProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:indeterminateTint="@color/ksu_blue" />

        <include
            android:id="@+id/myReportsEmpty"
            layout="@layout/view_empty" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabNewReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="18dp"
            android:text="بلاغ جديد"
            android:textAppearance="@style/TextAppearance.LF.Button"
            android:textColor="@color/white"
            app:backgroundTint="@color/ksu_blue"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/white" />
    </FrameLayout>
</LinearLayout>
