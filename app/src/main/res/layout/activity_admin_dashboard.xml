<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- الترويسة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvAdminAvatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle_blue"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="م"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/LF.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="لوحة تحكم المسؤول" />

            <TextView
                android:id="@+id/tvAdminName"
                style="@style/LF.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="مسؤول النظام"
                android:textSize="17sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnAdminProfile"
            style="@style/LF.IconButton.Circle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="الملف الشخصي"
            android:padding="11dp"
            android:src="@drawable/ic_person" />

        <ImageView
            android:id="@+id/btnAdminLogout"
            style="@style/LF.IconButton.Circle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:contentDescription="تسجيل الخروج"
            android:padding="11dp"
            android:src="@drawable/ic_logout"
            app:tint="@color/danger_text" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/adminRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/adminScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_background"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- البطاقة الرئيسية -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_admin"
                    android:elevation="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/LF.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="إدارة البلاغات"
                            android:textColor="@color/white"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAdminHeroSubtitle"
                            style="@style/LF.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="3dp"
                            android:text="راجع البلاغات الجديدة واعتمد المطابقات المقترحة"
                            android:textColor="@color/hero_subtitle"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAdminViewAllReports"
                            style="@style/LF.Button.White"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="كل البلاغات"
                            app:icon="@drawable/ic_reports" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_circle_white_20"
                        android:contentDescription="@null"
                        android:padding="18dp"
                        android:src="@drawable/ic_dashboard"
                        app:tint="@color/white" />
                </LinearLayout>

                <!-- الإحصائيات -->
                <TextView
                    style="@style/LF.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="نظرة عامة" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <include android:id="@+id/adminStatReports" layout="@layout/view_stat" />

                    <Space android:layout_width="10dp" android:layout_height="1dp" />

                    <include android:id="@+id/adminStatMatches" layout="@layout/view_stat" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <include android:id="@+id/adminStatReviewed" layout="@layout/view_stat" />

                    <Space android:layout_width="10dp" android:layout_height="1dp" />

                    <include android:id="@+id/adminStatReturned" layout="@layout/view_stat" />
                </LinearLayout>

                <!-- البلاغات الجديدة -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/LF.Text.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="بلاغات بانتظار المراجعة" />

                    <TextView
                        android:id="@+id/adminNewSeeAll"
                        style="@style/LF.Text.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عرض الكل" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/adminProgress"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:indeterminateTint="@color/ksu_blue" />

                <LinearLayout
                    android:id="@+id/adminNewReportsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/adminNewReportsEmpty"
                    style="@style/LF.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_notice_green"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:text="لا توجد بلاغات جديدة. كل شيء تحت السيطرة ✨"
                    android:textColor="@color/found_green"
                    android:visibility="gone" />

                <!-- بلاغات تحتاج متابعة: إفادة بأن الغرض ليس لصاحبه، أو تكرار فشل التحقق -->
                <LinearLayout
                    android:id="@+id/adminAttentionSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/LF.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="بلاغات تحتاج متابعة" />

                    <TextView
                        style="@style/LF.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="أفاد صاحب البلاغ أن الغرض المطابق ليس له، أو تكرر فشل التحقق في المركز" />

                    <LinearLayout
                        android:id="@+id/adminAttentionContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- المطابقات -->
                <TextView
                    style="@style/LF.Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="مطابقات مقترحة" />

                <TextView
                    style="@style/LF.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="لكل بلاغ مفقود: الاقتراح الأول هو الأعلى نسبة، والبقية بدائل محفوظة. طلبات أصحاب البلاغات تظهر أولًا." />

                <LinearLayout
                    android:id="@+id/adminMatchesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/adminMatchesEmpty"
                    style="@style/LF.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_notice_blue"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:text="لا توجد مطابقات مقترحة حاليًا."
                    android:textColor="@color/ksu_blue"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- شريط التنقل -->
    <LinearLayout
        style="@style/LF.BottomBar"
        android:layout_height="68dp">

        <LinearLayout android:id="@+id/navAdminHome" style="@style/LF.NavItem">
            <ImageView style="@style/LF.NavIcon" android:contentDescription="@null" android:src="@drawable/ic_dashboard" />
            <TextView style="@style/LF.NavLabel" android:text="الرئيسية" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navAdminReports" style="@style/LF.NavItem">
            <ImageView style="@style/LF.NavIcon" android:contentDescription="@null" android:src="@drawable/ic_reports" />
            <TextView style="@style/LF.NavLabel" android:text="البلاغات" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navAdminMatches" style="@style/LF.NavItem">
            <ImageView style="@style/LF.NavIcon" android:contentDescription="@null" android:src="@drawable/ic_compare" />
            <TextView style="@style/LF.NavLabel" android:text="المطابقات" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navAdminNotifications" style="@style/LF.NavItem">
            <ImageView style="@style/LF.NavIcon" android:contentDescription="@null" android:src="@drawable/ic_bell" />
            <TextView style="@style/LF.NavLabel" android:text="الإشعارات" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
