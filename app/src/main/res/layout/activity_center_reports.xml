<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <LinearLayout style="@style/LF.Toolbar">
        <ImageView
            android:id="@+id/btnBackCenterReports"
            style="@style/LF.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />
        <TextView
            style="@style/LF.Toolbar.Title"
            android:text="عمليات المركز" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/centerChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            app:checkedChip="@+id/chipCenterWaiting"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/chipCenterWaiting" style="@style/LF.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بانتظار الاستلام" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCenterAt" style="@style/LF.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="في المركز" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCenterReturned" style="@style/LF.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تم التسليم" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCenterAll" style="@style/LF.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الكل" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/app_background">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/centerReportsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp" />

        <ProgressBar
            android:id="@+id/centerReportsProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:indeterminateTint="@color/ksu_blue" />

        <include
            android:id="@+id/centerReportsEmpty"
            layout="@layout/view_empty" />
    </FrameLayout>
</LinearLayout>
